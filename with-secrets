#!/usr/bin/env bash
#
# with-secrets: Run a command with project secrets loaded from AWS SSM
# Parameter Store via `chamber`. One tool for many repos.
#
# Usage:
#   with-secrets [options] <command> [args...]
#
# Options:
#   -e, --env <env>        Environment (development|staging|test|...). Default: development.
#   -s, --service <name>   Chamber service path. Overrides everything else.
#   -p, --profile <name>   AWS profile to use.
#   -r, --region <region>  AWS region. Default: us-east-1.
#       --print            Print the resolved env vars (KEY=value lines) instead of running a command.
#       --export           Print `export KEY=value` lines (suitable for `eval`).
#       --dotenv           Print KEY="value" lines (a `.env` file).
#       --service-name     Print the resolved chamber service path and exit.
#   -h, --help             Show this help.
#   -V, --version          Print version.
#
# Service resolution order (first match wins):
#   1. --service flag
#   2. CHAMBER_SERVICE env var
#   3. `service=` line in .chamber file (project root, walks up from cwd)
#   4. <repo-slug>/<env>, where repo-slug is derived from:
#        a. `git config remote.origin.url` -> "<owner>/<repo>"
#        b. fallback to basename of the git toplevel directory
#
# .chamber file format (shell-sourceable, all keys optional):
#   service=dokio/development      # full override; if set, --env is ignored
#   service_prefix=dokio           # combined with env: dokio/<env>
#   env=development                # default env for this repo
#   profile=dokio-dev              # default AWS profile
#   region=us-east-1               # default AWS region
#
# Examples:
#   with-secrets bin/rails console
#   with-secrets -e staging bin/dev
#   with-secrets --print
#   eval "$(with-secrets --export)"
#   with-secrets --dotenv > .env.local

set -euo pipefail

VERSION="0.1.0"

usage() {
  sed -n '3,30p' "$0" | sed 's/^# \{0,1\}//'
}

die() {
  echo "with-secrets: $*" >&2
  exit 1
}

# --- arg parsing -------------------------------------------------------------

OPT_ENV=""
OPT_SERVICE=""
OPT_PROFILE=""
OPT_REGION=""
OPT_MODE="exec"   # exec | print | export | dotenv | service-name

while [ "$#" -gt 0 ]; do
  case "$1" in
    -e|--env)         OPT_ENV="${2:?--env needs a value}"; shift 2 ;;
    -s|--service)     OPT_SERVICE="${2:?--service needs a value}"; shift 2 ;;
    -p|--profile)     OPT_PROFILE="${2:?--profile needs a value}"; shift 2 ;;
    -r|--region)      OPT_REGION="${2:?--region needs a value}"; shift 2 ;;
    --print)          OPT_MODE="print"; shift ;;
    --export)         OPT_MODE="export"; shift ;;
    --dotenv)         OPT_MODE="dotenv"; shift ;;
    --service-name)   OPT_MODE="service-name"; shift ;;
    -h|--help)        usage; exit 0 ;;
    -V|--version)     echo "with-secrets $VERSION"; exit 0 ;;
    --)               shift; break ;;
    -*)               die "unknown option: $1 (try --help)" ;;
    *)                break ;;
  esac
done

# --- locate .chamber (walks up from cwd) -------------------------------------

find_chamber_file() {
  local dir="$PWD"
  while [ "$dir" != "/" ] && [ -n "$dir" ]; do
    if [ -f "$dir/.chamber" ]; then
      echo "$dir/.chamber"
      return 0
    fi
    dir="$(dirname "$dir")"
  done
  return 1
}

CONF_SERVICE=""
CONF_SERVICE_PREFIX=""
CONF_ENV=""
CONF_PROFILE=""
CONF_REGION=""

CHAMBER_FILE="$(find_chamber_file || true)"
if [ -n "$CHAMBER_FILE" ]; then
  # Parse safely: only accept key=value lines with known keys, ignore everything else.
  while IFS='=' read -r key value; do
    # strip surrounding whitespace and optional quotes
    key="$(echo "$key" | tr -d '[:space:]')"
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    case "$value" in
      \"*\") value="${value#\"}"; value="${value%\"}" ;;
      \'*\') value="${value#\'}"; value="${value%\'}" ;;
    esac
    case "$key" in
      service)        CONF_SERVICE="$value" ;;
      service_prefix) CONF_SERVICE_PREFIX="$value" ;;
      env)            CONF_ENV="$value" ;;
      profile)        CONF_PROFILE="$value" ;;
      region)         CONF_REGION="$value" ;;
      ''|\#*)         : ;;  # blank or comment
      *)              : ;;  # ignore unknown keys
    esac
  done < "$CHAMBER_FILE"
fi

# --- repo slug detection -----------------------------------------------------

repo_slug_from_git() {
  if ! git rev-parse --show-toplevel >/dev/null 2>&1; then
    return 1
  fi
  local url
  url="$(git config --get remote.origin.url 2>/dev/null || true)"
  if [ -n "$url" ]; then
    # Strip .git suffix and either git@host:owner/repo or https://host/owner/repo
    url="${url%.git}"
    case "$url" in
      *:*) echo "${url##*:}"; return 0 ;;       # git@github.com:owner/repo
      *)   echo "${url#*://*/}"; return 0 ;;    # https://github.com/owner/repo
    esac
  fi
  basename "$(git rev-parse --show-toplevel)"
}

# Reduce "owner/repo" to just "repo" by default (clean SSM paths).
# If a user wants the owner included, they can set service_prefix in .chamber.
repo_short_slug() {
  local full
  full="$(repo_slug_from_git)" || return 1
  echo "${full##*/}"
}

# --- resolve final values ----------------------------------------------------

ENV_NAME="${OPT_ENV:-${WITH_SECRETS_ENV:-${CONF_ENV:-development}}}"

if [ -n "$OPT_SERVICE" ]; then
  SERVICE="$OPT_SERVICE"
elif [ -n "${CHAMBER_SERVICE:-}" ]; then
  SERVICE="$CHAMBER_SERVICE"
elif [ -n "$CONF_SERVICE" ]; then
  SERVICE="$CONF_SERVICE"
elif [ -n "$CONF_SERVICE_PREFIX" ]; then
  SERVICE="$CONF_SERVICE_PREFIX/$ENV_NAME"
else
  if slug="$(repo_short_slug 2>/dev/null)" && [ -n "$slug" ]; then
    SERVICE="$slug/$ENV_NAME"
  else
    die "could not determine chamber service (not in a git repo and no .chamber file). Use --service or create a .chamber file."
  fi
fi

# AWS profile/region resolution: env > flag > .chamber. Flags override env.
[ -n "$OPT_PROFILE" ] && export AWS_PROFILE="$OPT_PROFILE"
[ -z "${AWS_PROFILE:-}" ] && [ -n "$CONF_PROFILE" ] && export AWS_PROFILE="$CONF_PROFILE"
[ -n "$OPT_REGION" ] && export AWS_REGION="$OPT_REGION"
[ -z "${AWS_REGION:-}" ] && export AWS_REGION="${CONF_REGION:-us-east-1}"

export CHAMBER_SERVICE="$SERVICE"

# --- mode: service-name (debug helper) ---------------------------------------

if [ "$OPT_MODE" = "service-name" ]; then
  echo "$SERVICE"
  exit 0
fi

# --- tool checks -------------------------------------------------------------

if ! command -v chamber >/dev/null 2>&1; then
  cat >&2 <<'EOF'
with-secrets: `chamber` is not installed.

Install:
  macOS:   brew install chamber
  Linux:   ARCH=$(uname -m | sed 's/x86_64/amd64/;s/aarch64/arm64/') && \
           sudo curl -L -o /usr/local/bin/chamber \
             "https://github.com/segmentio/chamber/releases/latest/download/chamber-v3.1.5-linux-${ARCH}" && \
           sudo chmod +x /usr/local/bin/chamber
  Source:  go install github.com/segmentio/chamber/v3@latest
EOF
  exit 127
fi

if ! command -v aws >/dev/null 2>&1; then
  echo "with-secrets: \`aws\` CLI is not installed. See https://aws.amazon.com/cli/" >&2
  exit 127
fi

# --- AWS creds sanity check (only for modes that hit AWS) --------------------

if ! aws sts get-caller-identity >/dev/null 2>&1; then
  cat >&2 <<EOF
with-secrets: AWS credentials missing or expired.

Try:
  aws sso login${AWS_PROFILE:+ --profile $AWS_PROFILE}
  export AWS_PROFILE=<profile>

Current AWS_PROFILE: ${AWS_PROFILE:-<unset>}
Current AWS_REGION:  ${AWS_REGION}
Resolved service:    ${SERVICE}
EOF
  exit 1
fi

# --- modes -------------------------------------------------------------------

case "$OPT_MODE" in
  exec)
    if [ "$#" -eq 0 ]; then
      echo "Usage: with-secrets <command> [args...]   (or --print/--export/--dotenv)" >&2
      exit 64
    fi
    exec chamber exec "$SERVICE" -- "$@"
    ;;
  print)
    # KEY=value lines, one per var.
    chamber env "$SERVICE" | sed 's/^export //; s/^\([^=]*\)="\(.*\)"$/\1=\2/'
    ;;
  export)
    chamber env "$SERVICE"
    ;;
  dotenv)
    chamber export -f dotenv "$SERVICE"
    ;;
esac
